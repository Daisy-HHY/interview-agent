{
  "name": "interview-agent",
  "displayName": "Interview Agent",
  "description": "会调工具的 AI 面试官——Agent 主动调用工具核对代码、给出基于真实代码的追问",
  "version": "0.2.0",
  "publisher": "daisy-hhy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Daisy-HHY/interview-agent.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:interview.chatView",
    "onCommand:interview.start",
    "onCommand:interview.askAboutSelection"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "interview-agent",
          "title": "Interview Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "interview-agent": [
        {
          "id": "interview.chatView",
          "type": "webview",
          "name": "面试"
        }
      ]
    },
    "commands": [
      {
        "command": "interview.start",
        "title": "Interview Agent: 开始面试"
      },
      {
        "command": "interview.askAboutSelection",
        "title": "Interview Agent: 针对选中代码提问",
        "enablement": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Interview Agent",
      "properties": {
        "interview.apiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI 兼容服务的 API Key（必填，否则无法发起面试）。"
        },
        "interview.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "使用的模型名（OpenAI 兼容）。"
        },
        "interview.baseUrl": {
          "type": "string",
          "default": "",
          "description": "OpenAI 兼容服务的 base URL。留空使用官方 OpenAI；填国内中转或兼容端点可接入 DeepSeek / 智谱 / 通义等。"
        },
        "interview.resume": {
          "type": "string",
          "default": "",
          "description": "简历摘要（可选）。注入系统提示，帮面试官了解你的背景。"
        },
        "interview.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python 解释器路径（用于启动 Agent 内核）。默认用系统 PATH 里的 python。"
        },
        "interview.demoMode": {
          "type": "boolean",
          "default": false,
          "description": "演示模式：用内置 FakeLLM 代替真实 API，零费用跑完整闭环。用于无 API 额度时体验面试官对话效果。"
        },
        "interview.maxSteps": {
          "type": "number",
          "default": 8,
          "description": "Agent 单轮循环最大步数（安全阀）。LLM 一直调工具不收敛时，跑满此值停止。调大=更彻底但更慢更贵，调小=更快但可能没查够。"
        },
        "interview.maxHistoryTokens": {
          "type": "number",
          "default": 20000,
          "description": "对话历史 token 上限。超过时从最老的对话开始丢弃（保留系统提示和最新消息）。调小=省钱但可能丢上下文，调大=上下文全但更贵。"
        },
        "interview.maxKeptFull": {
          "type": "number",
          "default": 3,
          "description": "历史里保留完整（不压缩）的工具结果数量。最近的 N 个保留完整，更早的压成摘要。调大=保留更多代码细节但更贵。"
        },
        "interview.piMaxSteps": {
          "type": "number",
          "default": 32,
          "minimum": 8,
          "description": "Pi runtime 单轮最大模型回合数。Pi 会在模型停止调用工具后结束；该值仅作为防止无限工具循环的安全阀。"
        },
        "interview.compactionEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Pi checkpoint 上下文压缩。默认关闭；开启后达到阈值时只压缩本次模型请求上下文，失败自动回退。"
        },
        "interview.compactionTriggerTokens": {
          "type": "number",
          "default": 12000,
          "minimum": 1,
          "description": "Pi checkpoint 压缩触发的估算 token 数。"
        },
        "interview.compactionKeepMessages": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "description": "Pi checkpoint 压缩后保留的最近消息数量，系统提示始终保留。"
        },
        "interview.agentRuntime": {
          "type": "string",
          "enum": [
            "native",
            "langchain",
            "pi"
          ],
          "default": "native",
          "description": "Agent 运行时。native 使用内置循环；langchain 使用 LangChain / LangGraph 可选运行时；pi 使用 Python pi-style 可选运行时。"
        },
        "interview.enabledTools": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "list_directory",
              "search_code",
              "read_file",
              "lookup_questions"
            ]
          },
          "default": [
            "list_directory",
            "search_code",
            "read_file",
            "lookup_questions"
          ],
          "description": "启用的 Agent 工具名。默认启用基础只读工具；删除某项后，模型将看不到对应工具 schema。"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "interview.start"
        },
        {
          "command": "interview.askAboutSelection",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run prepare-agent",
    "compile": "tsc -p ./ && npm run copy-media",
    "copy-media": "node -e \"const fs=require('fs');fs.mkdirSync('media',{recursive:true});for(const f of ['styles.css','main.js','index.html'])fs.cpSync(`src/webview/${f}`,`media/${f}`)\"",
    "prepare-agent": "node scripts/prepare-agent.js",
    "package:list": "vsce ls",
    "package": "vsce package",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "mammoth": "^1.12.1",
    "pdf-parse": "^1.1.1"
  }
}
